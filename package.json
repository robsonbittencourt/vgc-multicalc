{
  "name": "vgc-multicalc",
  "version": "2.6.2",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && cp dist/browser/404/index.html dist/browser/404.html && node scripts/update-sitemap.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --exclude='**/*.performance.spec.ts'",
    "test-domain": "ng run vgc-multicalc:test-domain --watch=false",
    "test-coverage": "ng test --coverage --watch=false --exclude='**/*.performance.spec.ts' && node scripts/coverage-report.mjs",
    "test-watch": "ng test --exclude='**/*.performance.spec.ts'",
    "perf": "node history/performance/performance-suite.mjs",
    "smogon-parser": "tsx tools/smogon-data-parser/src/main.js",
    "e2e-test": "sh cypress/scripts/e2e-test.sh",
    "smoke-test": "node scripts/run-smoke.mjs",
    "server": "node scripts/local-paste-server.mjs",
    "test-lambdas": "node --test infra/modules/pastes/test/*.test.mjs",
    "og-assets": "tsx scripts/og-image/build-assets.ts",
    "og-sample": "node scripts/og-image/render-sample.mjs",
    "build-paste-page": "scripts/aws/build-paste-page.sh",
    "lint": "ng lint",
    "formatter": "npx prettier . --check",
    "check": "npm run lint && npm run formatter",
    "cy:run": "cypress run --browser chrome",
    "e2e-parallel": "cypress-parallel -s cy:run -t 4 -d cypress/e2e -p cypress/reporters/multi-reporter.json"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.2.1",
    "@angular/cdk": "22.2.1",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/material": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/platform-server": "22.2.1",
    "@angular/router": "22.2.1",
    "@angular/service-worker": "22.2.1",
    "@angular/ssr": "22.2.1",
    "@ngrx/signals": "22.0.1",
    "pdf-lib": "1.17.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@eslint/js": "10.0.1",
    "@vitest/coverage-istanbul": "5.0.3",
    "angular-eslint": "22.5.0",
    "cypress": "16.1.1",
    "cypress-multi-reporters": "2.0.5",
    "cypress-parallel": "0.15.0",
    "cypress-real-events": "1.15.1",
    "eslint": "10.12.0",
    "istanbul-lib-instrument": "6.0.3",
    "jsdom": "30.1.1",
    "mocha-junit-reporter": "2.2.1",
    "prettier": "3.9.9",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@ngrx/signals": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core"
    }
  }
}
