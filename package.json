{
  "name": "vgc-multicalc",
  "version": "2.3.2",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && cp dist/browser/404/index.html dist/browser/404.html && node scripts/update-sitemap.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --exclude='**/*.performance.spec.ts'",
    "test-domain": "ng run vgc-multicalc:test-domain --watch=false",
    "test-coverage": "ng test --coverage --watch=false --exclude='**/*.performance.spec.ts' && node scripts/coverage-report.mjs",
    "test-watch": "ng test --exclude='**/*.performance.spec.ts'",
    "perf": "node history/performance/performance-suite.mjs",
    "smogon-parser": "tsx tools/smogon-data-parser/src/main.js",
    "e2e-test": "npx cypress run --quiet; exit_code=$?; if [ $exit_code -eq 0 ]; then echo '✅ Tests PASSED successfully!\n'; else echo '❌ Tests FAILED.\n'; fi; exit $exit_code",
    "smoke-test": "node scripts/run-smoke.mjs",
    "lint": "ng lint",
    "formatter": "npx prettier . --check",
    "check": "npm run lint && npm run formatter"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.1.4",
    "@angular/cdk": "22.1.5",
    "@angular/common": "22.1.4",
    "@angular/compiler": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/forms": "22.1.4",
    "@angular/material": "22.1.5",
    "@angular/platform-browser": "22.1.4",
    "@angular/platform-server": "22.1.4",
    "@angular/router": "22.1.4",
    "@angular/service-worker": "22.1.4",
    "@angular/ssr": "22.1.7",
    "@ngrx/signals": "22.0.0",
    "dedent": "1.7.2",
    "koffing": "1.0.0",
    "pdf-lib": "1.17.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.7",
    "@angular/cli": "22.1.7",
    "@angular/compiler-cli": "22.1.4",
    "@eslint/js": "10.0.1",
    "@vitest/coverage-istanbul": "4.1.11",
    "angular-eslint": "22.2.0",
    "cypress": "16.0.0",
    "cypress-real-events": "1.15.0",
    "eslint": "10.9.1",
    "istanbul-lib-instrument": "6.0.3",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@ngrx/signals": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core"
    }
  }
}
