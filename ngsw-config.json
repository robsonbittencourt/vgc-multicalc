{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**"],
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/index.csr.html", "/manifest.json", "/*.css", "/main-*.js"]
      }
    },
    {
      "name": "app-chunks",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/*.js"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "assets",
      "urls": ["/assets/**"],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 5000,
        "maxAge": "365d"
      }
    }
  ]
}
